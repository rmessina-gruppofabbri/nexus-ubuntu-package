# /data/hmi/.env: impostazioni di QUESTA macchina per compose.yaml.
# Dopo una modifica: sudo hmi-apply-stack /data/hmi/compose.yaml

# "master" = il gateway sostituisce la HMI sulla linea della macchina
# "sniff"  = ascolta soltanto lo scambio CPU <-> vecchia HMI (nessuna trasmissione)
H7_MODE=master

# Linea seriale della macchina letta direttamente dal gateway (38400 8N1)
MACHINE_TRANSPORT=serial
SERIAL_PATH=/dev/ttyS4
SERIAL_BAUD=38400

# Convertitore seriale/Ethernet (server TCP, raw, 38400 8N1) o porta Ethernet
# della scheda al posto della linea seriale:
# MACHINE_TRANSPORT=tcp
# MACHINE_HOST=192.168.10.20
# MACHINE_PORT=5021

# Prova senza la macchina (CPU simulata): togliere il commento al servizio
# simulator in compose.yaml, poi impostare
# COMPOSE_PROFILES=sim
# MACHINE_TRANSPORT=tcp
# MACHINE_HOST=simulator
# MACHINE_PORT=5021

# 1 = risponde ai comandi AT del modem della CPU come il modem della vecchia HMI
TIM_MODEM_EMULATION=1

# OPC UA (opc.tcp://<OPCUA_HOSTNAME>:4841)
OPCUA_ENABLED=true
OPCUA_LANG=it
# Indirizzo di questo PC sulla rete di stabilimento, come lo raggiungono i client OPC UA
# OPCUA_HOSTNAME=192.168.10.5
# Interfaccia su cui pubblicare OPC UA (127.0.0.1 = non raggiungibile dalla rete)
# OPCUA_BIND=192.168.10.5

# Pannello operatore raggiungibile dalla rete (tablet, PC). 0.0.0.0 = tutte le
# interfacce: funziona anche con indirizzo DHCP che cambia. Per il solo kiosk
# locale: HMI_BIND=127.0.0.1
HMI_BIND=0.0.0.0
